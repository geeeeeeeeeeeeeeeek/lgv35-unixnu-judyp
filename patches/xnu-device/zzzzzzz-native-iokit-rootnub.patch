@@ -130,6 +130,17 @@ iokit_post_constructor_init(void)
  */
 void (*record_startup_extensions_function)(void) = NULL;
 
+/*
+ * UNI_CK: progress is signalled through vm_page_wire_count, which the boot-progress panel prints
+ * live in its MEM row by reading kernel memory itself (see the full comment in pexpert/arm/pe_init.c).
+ * Every UNI_BC site bumps the counter by 4; the panel's reading is wired = 56516 + 256 + 4*N and N
+ * names the last checkpoint completed. Site order in execution: BC10..BC22 are N=5..17 here; the
+ * table for every site lives in the pe_init.c comment block.
+ */
+extern "C" unsigned int vm_page_wire_count;
+extern "C" void boot_progress_stage(const char *text) __attribute__((weak_import));
+#define UNI_BC(text) do { if (boot_progress_stage) boot_progress_stage(text); vm_page_wire_count += 4; } while (0)
+
 void
 InitIOKit(void *dtTop)
 {
@@ -143,31 +153,44 @@ InitIOKit(void *dtTop)
 	// of iokit basic service initialisation, or better we have IOLib stuff
 	// initialise as basic OS services.
 	//
+	UNI_BC("BC10 InitIOKit body");
 	IOLibInit();
+	UNI_BC("BC11 IOLibInit done");
 	OSlibkernInit();
+	UNI_BC("BC12 OSlibkernInit done");
 	IOMachPortInitialize();
+	UNI_BC("BC13 IOMachPortInitialize done");
 
 	gIOProgressBackbufferKey  = OSSymbol::withCStringNoCopy(kIOProgressBackbufferKey);
 	gIORemoveOnReadProperties = OSSet::withObjects((const OSObject **) &gIOProgressBackbufferKey, 1);
+	UNI_BC("BC14 symbols done");
 
 	interruptAccountingInit();
+	UNI_BC("BC15 interruptAccountingInit done");
 
+	UNI_BC("BC16 new IOPlatformExpertDevice");
 	gRootNub = new IOPlatformExpertDevice;
+	UNI_BC("BC17 root nub allocated");
 	if (__improbable(gRootNub == NULL)) {
 		panic("Failed to allocate IOKit root nub");
 	}
+	UNI_BC("BC18 root nub init");
 	bool ok = gRootNub->init(dtTop);
+	UNI_BC("BC19 root nub inited");
 	if (__improbable(!ok)) {
 		panic("Failed to initialize IOKit root nub");
 	}
 	gRootNub->attach(NULL);
+	UNI_BC("BC20 root nub attached");
 
 	/* If the bootstrap segment set up a function to record startup
 	 * extensions, call it now.
 	 */
 	if (record_startup_extensions_function) {
+		UNI_BC("BC21 record_startup_extensions");
