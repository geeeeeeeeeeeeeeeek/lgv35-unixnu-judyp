diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index 433b6cd..c66b1c9 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -44,6 +44,39 @@ char iBoot_version[FW_VERS_LEN];
 char iBoot_Stage_2_version[FW_VERS_LEN];
 #endif /* defined(TARGET_OS_OSX) && defined(__arm64__) */
 
+/*
+ * UNI_CK: progress is signalled through vm_page_wire_count, which the boot-progress panel prints
+ * live in its MEM row by reading kernel memory itself. The counter is bumped at fixed checkpoints:
+ * +256 on entry to PE_init_iokit (identity: proves this kernel is the one running, since the value
+ * is far outside the natural spread) and +4 per checkpoint passed. The panel's reading is
+ * wired = 56516 + 256 + 4*N, and N names the last checkpoint completed. No printf, no IOLog and no
+ * call into the payload is involved: every previous output channel (printf after kdp_serial_init,
+ * IOLog, and kernel-side calls to the payload's boot_progress_stage, which the CI stub archive
+ * satisfied with an empty no-op) was proven or suspected dead, while this one only needs the panel
+ * to keep reading kernel memory, which it demonstrably does.
+ *
+ * Execution-order checkpoint table (N = (wired - 56772) / 4):
+ *   0 PE_init_iokit entered (+256, identity)
+ *   1 PE_init_printf(TRUE) returned
+ *   2 first post-switch printf ("iBoot version") completed
+ *   3 pe_prepare_images returned
+ *   4 before InitIOKit
+ *   5-17 InitIOKit internals (IOStartIOKit.cpp): BC10 body, BC11 IOLibInit, BC12 OSlibkernInit,
+ *       BC13 IOMachPortInitialize, BC14 symbols, BC15 interruptAccountingInit, BC16 before new,
+ *       BC17 allocated, BC18 before init, BC19 inited, BC20 attached, BC21 record_startup_extensions,
+ *       BC22 tail
+ *  18 InitIOKit returned
+ *  19 ConfigureIOKit returned
+ *  20 PE_lockdown_iokit entered
+ *  21 zalloc_iokit_lockdown returned
+ *  22 startIOServiceMatching entered
+ *  23 workLoop allocated
+ *  24 registerService entered
+ *  25 registerService done
+ *  26 StartIOKitMatching returned
+ */
+extern unsigned int vm_page_wire_count;
+
 /*
  * This variable is only modified once, when the BSP starts executing. We put it in __DATA_CONST
  * as page protections on kernel text early in startup are read-write. The kernel is
@@ -255,13 +288,21 @@ PE_init_iokit(void)
 	uint32_t        load_kernel_start_value = 0;
 	uint32_t        populate_registry_time_value = 0;
 
+	/* UNI_CK #0: identity marker, +256. From here the panel's wired row reads 56516+256+4*N. */
+	vm_page_wire_count += 256;
 	PE_init_printf(TRUE);
 
+	/* UNI_CK #1: survived PE_init_printf(TRUE) -- the console/screen takeover returned. */
+	vm_page_wire_count += 4;
+
 	printf("iBoot version: %s\n", iBoot_version);
 #if defined(TARGET_OS_OSX) && defined(__arm64__)
 	printf("iBoot Stage 2 version: %s\n", iBoot_Stage_2_version);
 #endif /* defined(TARGET_OS_OSX) && defined(__arm64__) */
 
+	/* UNI_CK #2: the first post-switch printf completed. */
+	vm_page_wire_count += 4;
+
 	if (kSuccess == SecureDTLookupEntry(0, "/chosen/memory-map", &entry)) {
 		boot_progress_element const *bootPict;
 
@@ -281,6 +322,9 @@ PE_init_iokit(void)
 
 	pe_prepare_images();
 
+	/* UNI_CK #3: pe_prepare_images returned. */
+	vm_page_wire_count += 4;
+
 	scale = PE_state.video.v_scale;
 	flip = 1;
 
@@ -371,8 +415,14 @@ PE_init_iokit(void)
 #endif
 	}
 
+	/* UNI_CK #4: about to call InitIOKit. */
+	vm_page_wire_count += 4;
 	InitIOKit(PE_state.deviceTreeHead);
+	/* UNI_CK #18: InitIOKit returned (internals are checkpointed inside it). */
+	vm_page_wire_count += 4;
 	ConfigureIOKit();
+	/* UNI_CK #19: ConfigureIOKit returned. */
+	vm_page_wire_count += 4;
 }
 
