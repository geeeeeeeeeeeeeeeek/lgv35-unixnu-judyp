+extern "C" int native_wl_trace; /* NATIVE_Z: defined in osfmk/kern/zalloc.c */
+
 void
 InitIOKit(void *dtTop)
 {
@@ -144,23 +146,36 @@ InitIOKit(void *dtTop)
 	// initialise as basic OS services.
 	//
 	IOLibInit();
+	IOLog("NATIVE_II: IOLibInit\n");
 	OSlibkernInit();
+	IOLog("NATIVE_II: OSlibkernInit\n");
 	IOMachPortInitialize();
+	IOLog("NATIVE_II: IOMachPortInitialize\n");
 
 	gIOProgressBackbufferKey  = OSSymbol::withCStringNoCopy(kIOProgressBackbufferKey);
 	gIORemoveOnReadProperties = OSSet::withObjects((const OSObject **) &gIOProgressBackbufferKey, 1);
+	IOLog("NATIVE_II: symbols\n");
 
 	interruptAccountingInit();
+	IOLog("NATIVE_II: interruptAccountingInit\n");
+
+	/* NATIVE_Z: the zalloc trace in osfmk/kern/zalloc.c is gated; open it for the rest of the
+	 * root nub construction, which is where the last frames before the stop are. */
+	native_wl_trace = 1;
 
 	gRootNub = new IOPlatformExpertDevice;
+	IOLog("NATIVE_II: new root nub %p\n", gRootNub);
 	if (__improbable(gRootNub == NULL)) {
 		panic("Failed to allocate IOKit root nub");
 	}
 	bool ok = gRootNub->init(dtTop);
+	IOLog("NATIVE_II: root nub init %d\n", ok);
 	if (__improbable(!ok)) {
 		panic("Failed to initialize IOKit root nub");
 	}
 	gRootNub->attach(NULL);
+	IOLog("NATIVE_II: root nub attached\n");
+	native_wl_trace = 0;
 
 	/* If the bootstrap segment set up a function to record startup
 	 * extensions, call it now.
diff --git a/libkern/c++/OSObject.cpp b/libkern/c++/OSObject.cpp
index cd00373..6611c9a 100644
--- a/libkern/c++/OSObject.cpp
+++ b/libkern/c++/OSObject.cpp
@@ -324,19 +324,17 @@ OSObject_typed_operator_new(kalloc_type_view_t ktv, vm_size_t size)
 	 * using the parent's operator new/delete. If we detect such
 	 * a case we default to using kalloc rather than kalloc_type
 	 */
-	void *mem = NULL;
-	if (size <= kalloc_type_get_size(ktv->kt_size)) {
-		/*
-		 * OSObject_typed_operator_new can be called from kexts,
-		 * use the external symbol for kalloc_type_impl as
-		 * kalloc_type_views generated at some external callsites
-		 * many not have been processed during boot.
-		 */
-		mem = kalloc_type_impl_external(ktv, Z_WAITOK_ZERO);
-	} else {
-		mem = kheap_alloc(KHEAP_DEFAULT, size,
-		    Z_VM_TAG_BT(Z_WAITOK_ZERO, VM_KERN_MEMORY_LIBKERN));
-	}
+	/*
+	 * NATIVE_NEW: on judyp the boot stops in the first kalloc_type allocation -- InitIOKit ->
+	 * new IOPlatformExpertDevice -> OSObject_typed_operator_new -> kalloc_type_impl_external ->
+	 * zalloc_ext -> zone_expand_locked, with interrupts masked and no panic. To tell "the type
+	 * zone is the problem" apart from "any allocation under this call is the problem", every
+	 * OSObject is taken from kheap_alloc here, which is the path operator delete already frees
+	 * to, and which the plain OSObject::operator new above has always used.
+	 */
+	(void)ktv;
+	void *mem = kheap_alloc(KHEAP_DEFAULT, size,
+	    Z_VM_TAG_BT(Z_WAITOK_ZERO, VM_KERN_MEMORY_LIBKERN));
 	assert(mem);
 	OSIVAR_ACCUMSIZE(size);
 
