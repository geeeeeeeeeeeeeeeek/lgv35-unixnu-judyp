+/*
+ * UNI_DT: stage points inside IODeviceTreeAlloc, same weak channel as BC10..BC22 in
+ * iokit/Kernel/IOStartIOKit.cpp (package/BootProgress.c paints the panel from the caller, so a
+ * breadcrumb survives the IRQ-off hard lock).  BC50..BC56 only; the InitIOKit/matching/lockdown
+ * ranges are 10..22, 30..33 and 40..42.
+ */
+extern "C" void boot_progress_stage(const char *text) __attribute__((weak_import));
+#define UNI_DT(text) do { if (boot_progress_stage) boot_progress_stage(text); } while (0)
+
 // FIXME: Implementation of this function is hidden from the static analyzer.
 // The analyzer doesn't know that the registry holds retains, and gets confused
 // about releases after calls to 'attachToParent'.
@@ -128,6 +137,9 @@
 	bool                        freeDT;
 	char                        exBootArg[64];
 	const char *                found;
+	static unsigned int         uni_dt_children;
+
+	UNI_DT("BC50 DTAlloc enter");
 
 	gIODTPlane = IORegistryEntry::makePlane( kIODeviceTreePlane );
 
@@ -186,6 +198,8 @@
 	    && gIODTResolvers && gIODTResolvers->lock && gIODTResolvers->resolvers
 	    );
 
+	UNI_DT("BC51 DTAlloc globals ready");
