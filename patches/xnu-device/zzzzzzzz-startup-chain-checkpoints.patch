--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -796,25 +796,35 @@
 	kernel_bootstrap_log("kernel_do_post - done");
 #endif /* CONFIG_XNUPOST */
 
+/* UNI_CK: see zzzzzzzz-native-iokit-rootnub.patch -- every site bumps vm_page_wire_count
+ * by 4 and reports through boot_progress_stage; sites 27..29 continue the table in
+ * pexpert/arm/pe_init.c past PE_lockdown_iokit. boot_progress.h is already included. */
+extern unsigned int vm_page_wire_count;
+#define UNI_BC(text) do { boot_progress_stage(text); vm_page_wire_count += 4; } while (0)
+
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_lockdown_iokit");
 	PE_lockdown_iokit();
+	UNI_BC("BC37 lockdown returned");
 #endif
 	/*
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
 	 * at the latest
 	 */
 	vm_set_restrictions(machine_info.max_cpus);
+	UNI_BC("BC38 vm_set_restrictions done");
 
 
 #if KPERF
 	kperf_init_early();
+	UNI_BC("BC39 kperf early done");
 #endif
 
 	/*
 	 *	Start the user bootstrap.
 	 */
 #ifdef  MACH_BSD
+	UNI_BC("BC44 enter bsd_init");
 	bsd_init();
 #endif
 
