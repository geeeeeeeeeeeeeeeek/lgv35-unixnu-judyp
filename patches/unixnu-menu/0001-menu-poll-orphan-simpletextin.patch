+
+STATIC
+EFI_STATUS
+ReadInputKey (
+  IN  EFI_SIMPLE_TEXT_INPUT_PROTOCOL  **Orphans,
+  IN  UINTN                           OrphanCount,
+  OUT EFI_INPUT_KEY                   *Key
+  )
+{
+  UINTN  Index;
+
+  if (gST->ConIn != NULL) {
+    if (!EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, Key))) {
+      return EFI_SUCCESS;
+    }
+  }
+
+  for (Index = 0; Index < OrphanCount; Index++) {
+    if (!EFI_ERROR (Orphans[Index]->ReadKeyStroke (Orphans[Index], Key))) {
+      return EFI_SUCCESS;
+    }
+  }
+
+  return EFI_NOT_READY;
 }
 
